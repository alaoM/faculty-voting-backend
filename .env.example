# ==============================================================================
# ARMTI Faculty Voting Backend - Environment Configuration Template
# Copy this file to .env and fill in your secure production credentials.
# ==============================================================================

# Server Port
PORT=3000

# Database Configuration (MySQL)
# Set DB_TYPE=mysql in production. (Falls back to local sqlite if MySQL is unreachable)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=armti_voting

# Admin Security PIN / Password (Required for unlocking the Admin Dashboard)
ADMIN_PIN=set_your_secret_admin_password_here

# Live Google Sheet Export URL (Faculty Roster CSV Endpoint)
SHEET_URL=https://docs.google.com/spreadsheets/d/1xIoond8as5yz8ZxKP6miLQq8I8oOvi7whQsaBKnWBbg/export?format=csv
